<!-- 4. CARD TRANSFER MODAL (KARTLAR ARASI TRANSFER) -->
<div class="modal fade" id="transferModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Card" asp-action="Transfer" method="post">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-arrow-left-right me-2"></i>Kartlar Arası Transfer
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <!-- Göndərən Kart -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-credit-card-2-front text-danger me-1"></i> Göndərən Kart
                        </label>
                        <select name="FromCardId" class="form-select" required>
                            <option value="" disabled selected>Göndərən kartı seçin...</option>
                            @if (Model.Cards != null && Model.Cards.Any())
                            {
                                foreach (var c in Model.Cards)
                                {
                                    <option value="@c.Id">@c.CardName (@c.Balance.ToString("N2") @c.Currency)</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Alan Kart -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-credit-card-2-back text-success me-1"></i> Alan Kart
                        </label>
                        <select name="ToCardId" class="form-select" required>
                            <option value="" disabled selected>Alan kartı seçin...</option>
                            @if (Model.Cards != null && Model.Cards.Any())
                            {
                                foreach (var c in Model.Cards)
                                {
                                    <option value="@c.Id">@c.CardName (@c.Balance.ToString("N2") @c.Currency)</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Məbləğ -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-cash-stack text-warning me-1"></i> Köçürüləcək Məbləğ
                        </label>
                        <input type="number" name="Amount" step="0.01" min="0.01" class="form-control" placeholder="0.00" required
                               oninvalid="this.setCustomValidity('Zəhmət olmasa köçürüləcək məbləği daxil edin.')"
                               oninput="this.setCustomValidity('')" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                        <i class="bi bi-arrow-repeat me-1"></i> Köçürməni İcra Et
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <!-- Model məlumatlarının JS qrafiki (Chart.js) üçün dinamik ötürülməsi -->
    <script>
        window.dashboardChartData = {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryExpenses?.Select(x => x.CategoryName) ?? new List<string>())),
            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryExpenses?.Select(x => x.Amount) ?? new List<decimal>()))
        };
    </script>
    <script src="~/assets/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/assets/js/budgetChart.js" asp-append-version="true"></script>
}