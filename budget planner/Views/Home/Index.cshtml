            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.CategoryExpenses?.Select(x => x.CategoryName) ?? new List<string>()
                    )),
        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.CategoryExpenses?.Select(x => x.Amount) ?? new List<decimal>()
                ))
    };

        // Valyuta məzənnələri
        window.exchangeRates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.ExchangeRates?.ToDictionary(x => x.Code, x => x.Rate)
                ?? new Dictionary<string, decimal>()
        ));
</script>

    <script src="~/assets/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/assets/js/budgetChart.js" asp-append-version="true"></script>
}