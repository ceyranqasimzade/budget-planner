@using Microsoft.AspNetCore.Identity
@using budget_planner.Models
@inject SignInManager<ApplicationUser> SignInManager
@using budget_planner.Services
@model budget_planner.ViewModels.DashboardVM
@{
    ViewData["Title"] = "İcmal";
    // 1. İstifadəçinin sistemə daxil olub-olmadığını yoxlayırıq
    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/dashboard.css" asp-append-version="true" />

    <!-- Flag Icons CDN (Rəngli bayraqlar üçün) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.0/css/flag-icons.min.css" />

    <!-- ================= QLOBAL ŞRİFT VƏ OXUNURLUQ DƏSTƏYİ ================= -->
    <style>
        /* Manat (₼) simvolunun bütün cihazlarda düzgün görünməsi üçün */
        body, html, .stat-amount, span, strong, td, th, h1, h2, h3, h4, h5, h6 {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
        }

        /* Modal daxilində uzun valyuta/kart adlarının daşmasının qarşısını almaq üçün */
        .modal-body select.form-select {
            width: 100%;
            text-overflow: ellipsis;
            white-space: nowrap;
            overflow: hidden;
        }
    </style>
}

@if (!SignInManager.IsSignedIn(User))
{
    <div class="alert-warning-custom alert-dismissible fade show mb-4 shadow-sm d-flex align-items-center justify-content-between" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill alert-icon me-3 fs-4"></i>
            <div>
                <h6 class="alert-title mb-1 fw-bold">Diqqət!</h6>
                <p class="alert-text mb-0">
                    Siz sistemə daxil olmamısınız. Daxil etdiyiniz gəlir və xərclər brauzeri bağladıqda silinəcək.
                    <a asp-controller="Account" asp-action="Login" class="alert-link">Daxil olun</a>
                    və ya
                    <a asp-controller="Account" asp-action="Register" class="alert-link">Qeydiyyatdan keçin</a>.
                </p>
            </div>
        </div>
        <button type="button" class="btn-close ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<!-- ================= 1. LIVE CURRENCY TICKER (VALYUTA KURLARI) ================= -->
<div class="card mb-4 border-0 shadow-sm bg-body-tertiary">
    <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="font-size: 0.85rem;">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary">AMB Kursları</span>
            <span class="text-muted small">Canlı Məzənnə</span>
        </div>
        <div class="d-flex gap-3 fw-medium flex-wrap">
            @if (Model.ExchangeRates != null && Model.ExchangeRates.Any())
            {
                @foreach (var item in Model.ExchangeRates)
                {
                    // Valyuta koduna uyğun bayraq klassını təyin edirik
                    string flagClass = item.Code switch
                    {
                                    "USD" => "fi fi-us",
                                    "EUR" => "fi fi-eu",
                                    "TRY" => "fi fi-tr",
                                    "GBP" => "fi fi-gb",
                                    "RUB" => "fi fi-ru",
                                    "GEL" => "fi fi-ge",
                                    "AED" => "fi fi-ae",
                                    "CHF" => "fi fi-ch",
                                    "CNY" => "fi fi-cn",
                                    "CAD" => "fi fi-ca",
                        _ => "fi fi-xx"
                    };

                    // Dəyişimə görə rəng və Bootstrap İkonu
                    string colorClass = item.IsUp ? "text-success" : (item.IsDown ? "text-danger" : "text-secondary");
                    string iconClass = item.IsUp ? "bi-caret-up-fill" : (item.IsDown ? "bi-caret-down-fill" : "bi-dash");

                    <div class="d-inline-flex align-items-center me-2">
                        <!-- Rəngli Bayraq İkonu və Kod -->
                        <span class="@flagClass me-1 rounded-1"></span>
                        <span class="fw-bold text-body me-1">@item.Code:</span>

                        <!-- Əsas Məzənnə Rəqəmi -->
                        <strong class="@colorClass me-1">@item.Rate.ToString("0.0000") @Model.BaseCurrencySymbol</strong>

                        <!-- Fərq və Ox İşarəsi -->
                        <small class="@colorClass d-flex align-items-center" style="font-size: 0.75rem;">
                            <i class="bi @iconClass me-1"></i> @Math.Abs(item.Change).ToString("0.0000")
                        </small>
                    </div>
                }
            }
            else
            {
                <span class="text-muted">Məzənnələr yüklənir...</span>
            }
        </div>
    </div>
</div>

<!-- ================= PAGE HEADER & QUICK ACTIONS (TEZ ƏMƏLİYYAT DÜYMƏLƏRİ) ================= -->
<div class="page-header mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <!-- Başlıq və Büdcə Seçicisi (Multi-budget) -->
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <div>
            <h1 class="page-title fs-3 fw-bold mb-1">İcmal</h1>
            <p class="page-subtitle text-muted mb-0">Maliyyə vəziyyətinizə ümumi baxış</p>
        </div>
    </div>

    <!-- Right Actions: Əməliyyat Düymələri -->
    <div class="d-flex align-items-center gap-2 flex-wrap">

        <!-- Quick Action Buttons - Dəyişdirildi -->
        <button type="button" class="btn btn-success btn-sm px-3 d-flex align-items-center gap-1 shadow-sm" onclick="openModalIfAuth('#quickIncomeModal')">
            <i class="bi bi-plus-lg"></i> Gəlir Əlavə Et
        </button>
        <button type="button" class="btn btn-danger btn-sm px-3 d-flex align-items-center gap-1 shadow-sm" onclick="openModalIfAuth('#quickExpenseModal')">
            <i class="bi bi-dash-lg"></i> Xərc Əlavə Et
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center gap-1 shadow-sm" onclick="openModalIfAuth('#transferModal')">
            <i class="bi bi-arrow-left-right"></i> Transfer
        </button>

    </div>
</div>

<!-- ================= 2. BÜDCƏ LİMİTİ VƏ AĞILLI MƏSLƏHƏTÇİ BANNERS ================= -->
<div class="row mb-4 g-3 align-items-stretch">

    <!-- Büdcə Xəbərdarlığı -->
    <div class="col-md-7">
        <div class="alert alert-warning border-0 shadow-sm mb-0 d-flex align-items-center gap-3 p-3 h-100">
            <i class="bi bi-exclamation-triangle-fill fs-3 text-warning"></i>
            <div>
                <strong class="d-block">Büdcə Xəbərdarlığı!</strong>
                <span class="small">
                    @(string.IsNullOrEmpty(Model.BudgetWarning)
                                        ? "Hələ heç bir xərciniz yoxdur. Xərcləriniz yarandıqca sistem burada sizə limit xəbərdarlıqları edəcək." 
                                                : Model.BudgetWarning)
                </span>
            </div>
        </div>
    </div>

    <!-- Ağıllı Maliyyə Məsləhətçisi -->
    <div class="col-md-5">
        <div class="alert alert-info border-0 shadow-sm mb-0 d-flex align-items-center gap-3 p-3 h-100">
            <i class="bi bi-lightbulb-fill fs-3 text-info"></i>
            <div>
                <strong class="d-block">Maliyyə Məsləhəti</strong>
                <span class="small">
                    @(string.IsNullOrEmpty(Model.FinancialAdvice)
                                        ? "Maliyyə vəziyyətinizi analiz etmək üçün ilk gəlir və ya xərcinizi əlavə edin." 
                                                : Model.FinancialAdvice)
                </span>
            </div>
        </div>
    </div>

</div>

<!-- Ümumi Valyuta Seçimi -->
<div class="d-flex justify-content-end align-items-center mb-3">
    <label for="globalCurrency" class="fw-bold me-2">Göstərici Valyuta:</label>
    <select id="globalCurrency" class="form-select shadow-sm w-auto" onchange="changeGlobalCurrency()">
        <option value="AZN" selected>AZN (₼) - Manat</option>
        <option value="USD">USD ($) - Dollar</option>
        <option value="EUR">EUR (€) - Avro</option>
        <option value="TRY">TRY (₺) - Lirə</option>
        <option value="RUB">RUB (₽) - Rubl</option>
        <option value="GBP">GBP (£) - Sterlinq</option>
        <option value="GEL">GEL (₾) - Lari</option>
        <option value="AED">AED (د.إ) - Dirhəm</option>
        <option value="CHF">CHF (CHF) - Frank</option>
        <option value="CNY">CNY (¥) - Yuan</option>
        <option value="CAD">CAD ($) - Kanada Dolları</option>
    </select>
</div>

<!-- ================= 3. STATISTICS (ÖTƏN AYLA MÜQAYİSƏ İLƏ) ================= -->
<div class="row g-4 mb-4">
    <!-- Total Balance -->
    <div class="col-lg-4 col-md-6">
        <div class="card stat-card h-100">
            <div class="stat-icon balance">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="stat-details">
                <div class="stat-title">Ümumi Balans</div>
                <!-- 🟢 Bütün valyutalar AZN-ə çevrilərək toplandığı üçün burada AZN/₼ qalır -->
                <h3 class="stat-amount">
                    <span class="dynamic-amount" data-base-amount="@Model.TotalBalance.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        @Model.TotalBalance.ToString("N2") ₼
                    </span>
                </h3>
            </div>
        </div>
    </div>

    <!-- Income -->
    <div class="col-lg-4 col-md-6">
        <div class="card stat-card h-100">
            <div class="stat-icon income">
                <i class="bi bi-arrow-up-circle"></i>
            </div>
            <div class="stat-details">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="stat-title">Gəlir</div>

                    <!-- DİNAMİK GƏLİR FAİZİ (Həmişə görünəcək) -->
                    @{
                        decimal incTrend = Model.IncomeTrend ?? 0;
                    }
                    @if (incTrend == 0)
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill" style="font-size: 0.7rem;">- 0% keçən aydan</span>
                    }
                    else if (incTrend > 0)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.7rem;">↑ @incTrend.ToString("0.#")% keçən aydan</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill" style="font-size: 0.7rem;">↓ @Math.Abs(incTrend).ToString("0.#")% keçən aydan</span>
                    }
                </div>
                <h3 class="stat-amount text-income">
                    +<span class="dynamic-amount" data-base-amount="@Model.TotalIncome.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        @Model.TotalIncome.ToString("N2") ₼
                    </span>
                </h3>
            </div>
        </div>
    </div>

    <!-- Expense -->
    <div class="col-lg-4 col-md-6">
        <div class="card stat-card h-100">
            <div class="stat-icon expense">
                <i class="bi bi-arrow-down-circle"></i>
            </div>
            <div class="stat-details">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="stat-title">Xərc</div>

                    <!-- DİNAMİK XƏRC FAİZİ (Həmişə görünəcək) -->
                    @{
                        decimal expTrend = Model.ExpenseTrend ?? 0;
                    }
                    @if (expTrend == 0)
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill" style="font-size: 0.7rem;">- 0% keçən aydan</span>
                    }
                    else if (expTrend > 0)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill" style="font-size: 0.7rem;">↑ @expTrend.ToString("0.#")% keçən aydan</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill" style="font-size: 0.7rem;">↓ @Math.Abs(expTrend).ToString("0.#")% keçən aydan</span>
                    }
                </div>
                <h3 class="stat-amount text-expense">
                    -<span class="dynamic-amount" data-base-amount="@Model.TotalExpense.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        @Model.TotalExpense.ToString("N2") ₼
                    </span>
                </h3>
            </div>
        </div>
    </div>
</div>
<!-- ================= 4. MƏNİM KARTLARIM VƏ BALANSIM ================= -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Mənim Kartlarım və Balansım</h5>
    </div>

    <!-- BOOTSTRAP GRID (ROW) TƏTBİQ OLUNDU - flex-wrap problemi tam həll edildi -->
    <div class="row g-3">

        <!-- 🟢 1. NAĞD PUL (CİBDƏKİ PUL) KARTI -->
        <div class="col-12 col-sm-6 col-md-4 col-xl-3">
            <div class="card p-3 shadow-sm border-0 text-white rounded-3 h-100"
                 style="background: linear-gradient(135deg, #0f5132 0%, #198754 100%); min-height: 130px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-bold fs-6">Nağd Pul</span>
                    <i class="bi bi-wallet2 fs-4"></i>
                </div>
                <div class="mb-2">
                    <small class="opacity-75 d-block" style="font-size: 0.75rem;">Balans</small>
                    <h4 class="fw-bold mb-0">@Model.CashBalance.ToString("N2") ₼</h4>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small class="opacity-75">Cib / Cüzdan</small>
                    <span class="badge bg-light text-dark fw-normal" style="font-size: 0.7rem;">AZN</span>
                </div>
            </div>
        </div>

        <!-- 🔵 2. İSTİFADƏÇİNİN BANK KARTLARI -->
        @if (Model.Cards != null && Model.Cards.Any())
        {
            @foreach (var card in Model.Cards)
            {
                <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                    <div class="card p-3 shadow-sm border-0 text-white rounded-3 h-100"
                         style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); min-height: 130px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold fs-6">@card.CardName</span>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-credit-card-2-front fs-4"></i>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger border-0 text-white p-0"
                                        onclick="openDeleteCardModal(@card.Id, '@card.CardName')"
                                        title="Kartı Sil">
                                    <i class="bi bi-trash fs-5"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-2">
                            <small class="opacity-75 d-block" style="font-size: 0.75rem;">Balans</small>
                            <!-- 🟢 Yeniləndi: Valyuta kodu yerinə dinamik valyuta simvolu göstərilir -->
                            <h4 class="fw-bold mb-0">@card.Balance.ToString("N2") @CurrencyService.GetCurrencySymbol(card.Currency)</h4>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="opacity-75">•••• @card.Last4Digits</small>
                            <span class="badge bg-light text-dark fw-normal" style="font-size: 0.7rem;">@card.Currency</span>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- ➕ 3. "Kart əlavə et" düyməsi -->
        <div class="col-12 col-sm-6 col-md-4 col-xl-3">
            <div class="card add-card-box d-flex flex-column justify-content-center align-items-center text-center p-3 h-100"
                 style="min-height: 130px; cursor: pointer;"
                 data-bs-toggle="modal"
                 data-bs-target="#addCardModal">
                <i class="bi bi-plus-circle fs-2 add-icon mb-1"></i>
                <h6 class="mb-0 fw-bold" style="font-size: 0.9rem;">Kart əlavə et</h6>
                <small class="text-muted" style="font-size: 0.75rem;">Yeni bank kartı</small>
            </div>
        </div>

    </div> <!-- row sonu -->
</div>
<!-- MAIN ROW BAŞLANĞICI -->
<div class="row g-4">

    <!-- ========================================== -->
    <!-- SOL TƏRƏF (Son Əməliyyatlar + Qarşıdan Gələn Ödənişlər) -->
    <!-- ========================================== -->
    <div class="col-xl-8 col-lg-7 d-flex flex-column gap-4">

        <!-- 1. Son Əməliyyatlar -->
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Son Əməliyyatlar</h5>
                <a asp-controller="Transaction" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-1 text-decoration-none">
                    Hamısına bax <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr class="text-secondary border-bottom border-secondary">
                                <th>Tarix</th>
                                <th>Təsvir</th>
                                <th>Kateqoriya</th>
                                <th>Ödəniş Üsulu</th>
                                <th>Məbləğ</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LastTransactions != null && Model.LastTransactions.Any())
                            {
                                @foreach (var item in Model.LastTransactions)
                                {
                                    <tr>
                                        <td>@item.Date.ToString("dd.MM.yyyy")</td>
                                        <td><span class="text-truncate d-inline-block" style="max-width: 120px;">@item.Description</span></td>
                                        <td><span class="badge bg-secondary bg-opacity-25 text-body fw-normal">@(item.CategoryName ?? "Ümumi")</span></td>
                                        <td>
                                            @if (item.CardId.HasValue && item.CardId > 0)
                                            {
                                                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 px-2 py-1 d-inline-flex align-items-center">
                                                    <i class="fa-solid fa-credit-card me-1"></i> @(item.CardName ?? "Kart")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-25 text-body border border-secondary border-opacity-25 px-2 py-1 d-inline-flex align-items-center">
                                                    <i class="fa-solid fa-wallet me-1"></i> Nağd
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-bold @(item.IsIncome ? "text-success" : "text-danger")">
                                                @(item.IsIncome ? "+" : "-")@item.Amount.ToString("N2") @CurrencyService.GetCurrencySymbol(item.Currency)
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.IsIncome)
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-1">Gəlir</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 px-2 py-1">Xərc</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">Hələ heç bir əməliyyat yoxdur.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. Qarşıdan Gələn Ödənişlər -->
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="fa-regular fa-calendar-check text-primary me-2"></i>Qarşıdan Gələn Ödənişlər
                </h5>
                <a asp-controller="UpcomingPayment" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-1 text-decoration-none">
                    Hamısına bax <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>

            @{
                var upcomingList = ViewBag.UpcomingPayments as List<budget_planner.Models.UpcomingPayment>;
            }

            @if (upcomingList != null && upcomingList.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in upcomingList)
                    {
                        <div class="upcoming-payment-card d-flex justify-content-between align-items-center p-3 rounded-3 border" style="border-color: #e5e7eb !important; border-radius: 12px !important;">
                            <!-- Sol tərəf: İkon və Ad -->
                            <div class="d-flex align-items-center gap-3">
                                <div class="payment-icon-box bg-primary bg-opacity-10 d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; flex-shrink: 0;">
                                    <i class="fa-solid fa-receipt text-primary fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="fw-semibold mb-1 text-dark">@item.Title</h6>
                                    <span class="text-muted small d-flex align-items-center gap-1">
                                        <i class="fa-regular fa-clock"></i>
                                        Son tarix: <strong>@item.DueDate.ToString("dd.MM.yyyy")</strong>
                                    </span>
                                </div>
                            </div>

                            <!-- Sağ tərəf: Məbləğ və Status -->
                            <div class="text-end">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-2 fs-6 fw-bold">
                                    @item.Amount.ToString("N2") @item.Currency
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Boş olduqda göstəriləcək empty-state -->
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="fa-regular fa-calendar-xmark text-muted" style="font-size: 3rem;"></i>
                    </div>
                    <p class="text-muted mb-0">Hələ heç bir qarşıdan gələn ödəniş yoxdur.</p>
                </div>
            }
        </div>
        <!-- /Qarşıdan Gələn Ödənişlər -->

    </div> <!-- /SOL TƏRƏF SONU -->
    <!-- ========================================== -->
    <!-- SAĞ TƏRƏF (Xərclərin Bölgüsü + Hədəflərim) -->
    <!-- ========================================== -->
    <div class="col-xl-4 col-lg-5 d-flex flex-column gap-4">

        <!-- 3. Xərclərin Bölgüsü -->
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4 d-flex flex-column">
                <h5 class="fw-bold mb-3">Xərclərin bölgüsü</h5>

                <div class="w-100 d-flex align-items-center justify-content-center position-relative" style="min-height: 320px; height: 320px;">
                    @if (Model.CategoryExpenses != null && Model.CategoryExpenses.Any())
                    {
                        <canvas id="expenseChart" style="width: 100% !important; height: 100% !important;"></canvas>
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <i class="fa-solid fa-chart-pie text-secondary opacity-25 display-4 mb-3"></i>
                            <p class="mb-0 small">Bölgü aparmaq üçün hələ heç bir xərciniz yoxdur.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- AKTİV HƏDƏFLƏR KARTI -->
        <div class="card bg-dark text-white border-0 shadow-sm rounded-4 p-3 mb-4" style="background-color: #1e1e1e !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="m-0 d-flex align-items-center gap-2 fs-6 fw-bold text-light">
                    <i class="bi bi-bullseye text-success"></i> Aktiv Hədəflər
                </h5>
                <a asp-controller="Goal" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill px-3">
                    Hamısına bax <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            @if (Model.ActiveGoals != null && Model.ActiveGoals.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var goal in Model.ActiveGoals)
                    {
                        // Faizi hesablayırıq (maksimum 100%)
                        var percent = goal.TargetAmount > 0
                        ? (int)Math.Min(100, Math.Round((goal.CurrentAmount / goal.TargetAmount) * 100))
                        : 0;

                        <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                            <!-- 1. Hədəfin Adı və Faizi -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <!-- 🟢 Dinamik İkon (Sistem üzrə unifikasiya edilmiş bi-bullseye fallback ilə) -->
                                    <i class="bi @(string.IsNullOrEmpty(goal.IconClass) ? "bi-bullseye" : goal.IconClass) text-success"></i>
                                    <span class="fw-semibold text-light fs-6">@goal.Name</span>
                                </div>
                                <span class="badge bg-success bg-opacity-20 text-success fw-bold px-2 py-1 rounded-pill">
                                    @percent%
                                </span>
                            </div>

                            <!-- 2. Uzunsov Dolduqca Artan Progress Bar -->
                            <div class="progress" style="height: 10px; background-color: rgba(255, 255, 255, 0.1); border-radius: 10px;">
                                <div class="progress-bar bg-success progress-bar-striped progress-bar-animated"
                                     role="progressbar"
                                     style="width: @percent%; border-radius: 10px;"
                                     aria-valuenow="@percent"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-flag fs-2 d-block mb-2 opacity-50"></i>
                    Hələ heç bir aktiv hədəf yoxdur.
                </div>
            }
        </div>

    </div> <!-- /SAĞ TƏRƏF SONU -->

</div> <!-- /MAIN ROW SONU -->
