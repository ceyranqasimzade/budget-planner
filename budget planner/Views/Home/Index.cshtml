@{
    ViewData["Title"] = "İcmal";
}

<!-- Üst hissə: İcmal Kartları -->
<div class="dashboard-cards">
    <div class="stat-card">
        <div class="stat-header">
            <span class="stat-title">Ümumi Balans</span>
            <i class="bi bi-wallet2 text-blue icon-lg"></i>
        </div>
        <h3 class="stat-val">$2,450.00</h3>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <span class="stat-title">Gəlir</span>
            <i class="bi bi-arrow-up-right-circle-fill text-green icon-lg"></i>
        </div>
        <h3 class="stat-val text-green">+$3,200.00</h3>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <span class="stat-title">Xərc</span>
            <i class="bi bi-arrow-down-left-circle-fill text-red icon-lg"></i>
        </div>
        <h3 class="stat-val text-red">-$750.00</h3>
    </div>

    <!-- YENİLƏNMİŞ: 4-cü Kart (Kart Əlavə Et) -->
    <div class="stat-card add-card-box" data-bs-toggle="modal" data-bs-target="#addCardModal">
        <div class="add-content">
            <i class="bi bi-plus-circle"></i>
            <span>Kart əlavə et</span>
        </div>
    </div>
</div>

<!-- Alt hissə: Cədvəl və Qrafik -->
<div class="dashboard-content">
    <!-- Sol tərəf: Cədvəl -->
    <div class="transactions-section">
        <div class="stat-header" style="margin-bottom: 25px;">
            <h5 class="section-title">Son Əməliyyatlar</h5>
            <a href="#" class="text-blue" style="text-decoration: none; font-size: 14px;">Hamısına bax</a>
        </div>
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Tarix</th>
                    <th>Təsvir</th>
                    <th>Kateqoriya</th>
                    <th>Məbləğ</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>18 İyul 2026</td>
                    <td>Maaş</td>
                    <td><span class="status-badge bg-income">Gəlir</span></td>
                    <td class="text-green fw-bold">+$3,200.00</td>
                    <td><span class="status-badge bg-income">Tamamlandı</span></td>
                </tr>
                <tr>
                    <td>17 İyul 2026</td>
                    <td>Market alış-verişi</td>
                    <td><span class="status-badge bg-expense-food">Qida</span></td>
                    <td class="text-red fw-bold">-$120.50</td>
                    <td><span class="status-badge bg-income">Tamamlandı</span></td>
                </tr>
                <tr>
                    <td>15 İyul 2026</td>
                    <td>Elektrik enerjisi</td>
                    <td><span class="status-badge bg-expense-utility">Kommunal</span></td>
                    <td class="text-red fw-bold">-$45.00</td>
                    <td><span class="status-badge bg-expense-utility">Gözləyir</span></td>
                </tr>
            </tbody>
        </table>
    </div>
    <!-- Sağ tərəf: Qrafik -->
    <div class="chart-section">
        <h5 class="section-title" style="margin-bottom: 25px;">Xərclərin bölgüsü</h5>
        <canvas id="expenseChart" style="max-height: 250px;"></canvas>
    </div>
</div>

<!-- YENİLƏNMİŞ: Real Bank Kartları Modalı -->
<div class="modal fade" id="addCardModal" tabindex="-1" aria-labelledby="addCardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 15px; border: none;">
            <div class="modal-header" style="border-bottom: 1px solid #f1f1f1; padding: 20px 25px;">
                <h5 class="modal-title fw-bold" id="addCardModalLabel">Yeni Kart Əlavə Et</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 25px;">
                <p style="color: #6c757d; margin-bottom: 25px;">Əlavə etmək istədiyiniz bankı seçin:</p>

                <!-- Bootstrap Row/Col ilə qüsursuz Grid -->
                <div class="row g-3">
                    <!-- Leobank -->
                    <div class="col-6 col-md-3">
                        <div class="bank-card-option leobank">
                            <h4 class="bank-logo">Leo</h4>
                            <span class="bank-name">Leobank</span>
                        </div>
                    </div>
                    <!-- Birbank -->
                    <div class="col-6 col-md-3">
                        <div class="bank-card-option birbank">
                            <h4 class="bank-logo">Birbank</h4>
                            <span class="bank-name">Kapital Bank</span>
                        </div>
                    </div>
                    <!-- ABB -->
                    <div class="col-6 col-md-3">
                        <div class="bank-card-option abb">
                            <h4 class="bank-logo">ABB</h4>
                            <span class="bank-name">TamKart</span>
                        </div>
                    </div>
                    <!-- Ubank -->
                    <div class="col-6 col-md-3">
                        <div class="bank-card-option ubank">
                            <h4 class="bank-logo">Ubank</h4>
                            <span class="bank-name">Unibank</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/assets/js/dashboard.js"></script>