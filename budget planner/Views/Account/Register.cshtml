@model budget_planner.ViewModels.RegisterVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Qeydiyyat</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
    <div class="card p-4 shadow-sm" style="width: 380px;">
        <h3 class="text-center mb-3">Qeydiyyat</h3>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label>Ad və Soyad</label>
                <input asp-for="FullName" class="form-control" />
            </div>
            <div class="mb-3">
                <label>E-poçt</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Şifrə</label>
                <input asp-for="Password" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Şifrənin təkrarı</label>
                <input asp-for="ConfirmPassword" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Qeydiyyatdan Keç</button>
            <div class="mt-3 text-center">
                <a asp-action="Login">Hesabınız var? Daxil olun</a>
            </div>
        </form>
    </div>
</body>
</html>