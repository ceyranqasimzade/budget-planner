@model budget_planner.ViewModels.LoginVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Daxil Ol</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
    <div class="card p-4 shadow-sm" style="width: 380px;">
        <h3 class="text-center mb-3">Daxil Ol</h3>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label>E-poçt</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Şifrə</label>
                <input asp-for="Password" class="form-control" />
            </div>
            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label class="form-check-label">Məni xatırla</label>
            </div>
            <button type="submit" class="btn btn-success w-100">Daxil Ol</button>
            <div class="mt-3 text-center">
                <a asp-action="Register">Hesabınız yoxdur? Qeydiyyatdan keçin</a>
            </div>
        </form>
    </div>
</body>
</html>