@model budget_planner.ViewModels.ResetPasswordVM
@{ Layout = null; }
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <title>Yeni Şifrə</title>
    <link rel="stylesheet" href="~/assets/css/account.css" />
</head>
<body>
    <div class="login-background">
        <div class="login-box">
            <h2>Yeni Şifrə Təyin Et</h2>
            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="input-group">
                    <input asp-for="Password" type="password" placeholder="Yeni Şifrə" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password" placeholder="Şifrənin təkrarı" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-submit">Yadda saxla</button>
            </form>
        </div>
    </div>
</body>
</html>