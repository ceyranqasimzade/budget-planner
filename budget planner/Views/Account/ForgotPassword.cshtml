@model budget_planner.ViewModels.ForgotPasswordVM
@{ Layout = null; }
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <title>Şifrəni Sıfırla</title>
    <link rel="stylesheet" href="~/assets/css/account.css" />
</head>
<body>
    <div class="login-background">
        <div class="login-box">
            <h2>Şifrəni Sıfırla</h2>
            <p style="font-size:14px; margin-bottom:20px;">E-poçt ünvanınızı daxil edin. Sizə şifrə sıfırlama linki göndərəcəyik.</p>
            <form asp-action="ForgotPassword" method="post">
                <div class="input-group">
                    <input asp-for="Email" type="email" placeholder="E-poçt ünvanınız" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn-submit">Göndər</button>
                <div class="register-link"><a asp-action="Login">Geri qayıt</a></div>
            </form>
        </div>
    </div>
</body>
</html>