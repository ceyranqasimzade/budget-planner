@model budget_planner.ViewModels.Reports.ReportVM
@using System.Globalization
@using System.Text.Json
@using budget_planner.DAL
@using budget_planner.Models
@{
    ViewData["Title"] = "Maliyyə Hesabatları";
    var invCulture = CultureInfo.InvariantCulture;
    var currentCurrency = Model.Filter?.DisplayCurrency ?? "AZN";
}
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_green.css">
    <link rel="stylesheet" href="~/assets/css/report.css" asp-append-version="true" />
}
<div class="container-fluid px-4 py-3">
    <!-- 1. FİLTR PANELİ -->
    <div class="report-card mb-4">
        <div class="row g-3 align-items-end">
            <!-- Başlanğıc Tarixi -->
            <div class="col-md-3">
                <label class="form-label fw-semibold text-secondary small d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-event"></i> Başlanğıc Tarixi
                </label>
                <input type="text" id="startDate" class="form-control date-picker-input"
                       value="@Model.Filter?.StartDate?.ToString("yyyy-MM-dd")"
                       placeholder="Tarix seçin..." readonly>
            </div>
            <!-- Bitiş Tarixi -->
            <div class="col-md-3">
                <label class="form-label fw-semibold text-secondary small d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-check"></i> Bitiş Tarixi
                </label>
                <input type="text" id="endDate" class="form-control date-picker-input"
                       value="@Model.Filter?.EndDate?.ToString("yyyy-MM-dd")"
                       placeholder="Tarix seçin..." readonly>
            </div>
            <!-- Hesabat Valyutası -->
            <div class="col-md-3">
                <label class="form-label fw-semibold text-secondary small d-flex align-items-center gap-2">
                    <i class="bi bi-currency-exchange"></i> Hesabat Valyutası
                </label>
                <select id="currencySelect" class="form-select">
                    <option value="AZN" selected="@(currentCurrency == "AZN")">AZN (₼) - Azərbaycan Manatı</option>
                    <option value="USD" selected="@(currentCurrency == "USD")">USD ($) - ABŞ Dolları</option>
                    <option value="EUR" selected="@(currentCurrency == "EUR")">EUR (€) - Avro</option>
                    <option value="TRY" selected="@(currentCurrency == "TRY")">TRY (₺) - Türk Lirəsi</option>
                    <option value="RUB" selected="@(currentCurrency == "RUB")">RUB (₽) - Rusiya Rublu</option>
                    <option value="GBP" selected="@(currentCurrency == "GBP")">GBP (£) - Britaniya Funtu</option>
                    <option value="CHF" selected="@(currentCurrency == "CHF")">CHF (CHF) - İsveçrə Frankı</option>
                    <option value="CAD" selected="@(currentCurrency == "CAD")">CAD ($) - Kanada Dolları</option>
                    <option value="AUD" selected="@(currentCurrency == "AUD")">AUD ($) - Avstraliya Dolları</option>
                    <option value="CNY" selected="@(currentCurrency == "CNY")">CNY (¥) - Çin Yuanı</option>
                    <option value="JPY" selected="@(currentCurrency == "JPY")">JPY (¥) - Yapon Yeni</option>
                </select>
            </div>
            <!-- Düymələr -->
            <div class="col-md-3 d-flex gap-2">
                <button type="button" id="applyFilterBtn" class="btn btn-success flex-grow-1 fw-semibold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-funnel-fill"></i> Tətbiq Et
                </button>
                <button type="button" id="resetFilterBtn" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" style="width: 44px;" title="Sıfırla">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
    </div>
    <!-- 2. KPI TOP CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="report-card">
                <div class="d-flex justify-content-between">
                    <span class="kpi-title">Aylıq Gəlir</span>
                    <span class="badge bg-success-subtle text-success">↑ Gəlir</span>
                </div>
                <div class="kpi-value" id="kpiMonthlyIncome">@Model.Kpi?.MonthlyIncome.ToString("N2", invCulture) @currentCurrency</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="report-card">
                <div class="d-flex justify-content-between">
                    <span class="kpi-title">Aylıq Xərc</span>
                    <span class="badge bg-danger-subtle text-danger">↓ Xərc</span>
                </div>
                <div class="kpi-value" id="kpiMonthlyExpense">@Model.Kpi?.MonthlyExpense.ToString("N2", invCulture) @currentCurrency</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="report-card">
                <div class="d-flex justify-content-between">
                    <span class="kpi-title">Xalis Qənaət</span>
                    <span class="badge bg-info-subtle text-info">💰 Qənaət</span>
                </div>
                <div class="kpi-value text-info" id="kpiMonthlySavings">@Model.Kpi?.MonthlySavings.ToString("N2", invCulture) @currentCurrency</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="report-card text-center">
                <span class="kpi-title d-block mb-1">Maliyyə Sağlamlığı</span>
                <div class="health-gauge-box">
                    <canvas id="healthGaugeChart"></canvas>
                    <div class="health-score-text">
                        <div class="score" id="scoreText">@(Model.Kpi?.HealthScore ?? 0)</div>
                    </div>
                </div>
                <small class="fw-bold d-block mt-1" style="color: #f59e0b;">
                    @((Model.Kpi?.HealthScore ?? 0) < 40 ? "Kritik Vəziyyət" : (Model.Kpi?.HealthScore ?? 0) < 70 ? "Orta Vəziyyət" : "Əla Vəziyyət")
                </small>
            </div>
        </div>
    </div>
    <!-- 3. MAIN CHARTS ROW 1 -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="report-card">
                <h6 class="chart-title mb-3"><i class="bi bi-graph-up-arrow text-success me-2"></i>6 Aylıq Gəlir və Xərc Trendi</h6>
                <div class="chart-container">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="report-card">
                <h6 class="chart-title mb-3"><i class="bi bi-pie-chart-fill text-warning me-2"></i>50/30/20 Büdcə Qaydası</h6>
                <div class="chart-container">
                    <canvas id="rule503020Chart"></canvas>
                </div>
                <div class="mt-2 small text-muted text-center">
                    <span class="text-primary me-2">● 50% Ehtiyac</span>
                    <span class="text-warning me-2">● 30% İstək</span>
                    <span class="text-success">● 20% Yığım</span>
                </div>
            </div>
        </div>
    </div>
    <!-- 4. CHARTS ROW 2 -->
    <div class="row g-3">
        <div class="col-md-4">
            <div class="report-card">
                <h6 class="chart-title mb-3"><i class="bi bi-donut-chart text-info me-2"></i>Kateqoriya Bölgüsü (Bu ay)</h6>
                <div class="chart-container">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="report-card">
                <h6 class="chart-title mb-3"><i class="bi bi-bar-chart-line text-danger me-2"></i>Həftəlik Xərc İntensivliyi</h6>
                <div class="chart-container">
                    <canvas id="weekdayChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="report-card">
                <h6 class="chart-title mb-3"><i class="bi bi-list-stars text-warning me-2"></i>Top Xərc Kateqoriyaları</h6>
                <!-- 🟢 Dinamik AJAX yenilənməsi üçün ID əlavə olundu -->
                <div class="mt-3" id="topCategoriesList">
                    @if (Model.Categories?.TopCategories != null && Model.Categories.TopCategories.Any())
                    {
                        @foreach (var cat in Model.Categories.TopCategories)
                        {
                            var catName = string.IsNullOrWhiteSpace(cat.CategoryName) || cat.CategoryName == "qq" ? "Digər Xərclər" : cat.CategoryName;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold">@catName</span>
                                    <span class="fw-bold">@cat.Amount.ToString("N2", invCulture) @currentCurrency (@cat.Percentage.ToString("F1", invCulture)%)</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @cat.Percentage.ToString("F1", invCulture)%"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">Bu ay üçün heç bir xərc məlumatı tapılmadı.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/az.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/assets/js/report.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Server tərəfindən gələn datanı JSON kimi oxuyuruq
            var rawServerData = @Html.Raw(JsonSerializer.Serialize(Model, new JsonSerializerOptions
            {
                    PropertyNamingPolicy = JsonNamingPolicy.CamelCase
            }));

        if (rawServerData && rawServerData.categories) {
            if ((!rawServerData.categories.categoryNames || rawServerData.categories.categoryNames.length === 0)
                && rawServerData.categories.topCategories && rawServerData.categories.topCategories.length > 0) {

                    rawServerData.categories.categoryNames = rawServerData.categories.topCategories.map(c => c.categoryName);
                    rawServerData.categories.categoryExpenses = rawServerData.categories.topCategories.map(c => c.amount);
                }
            }
            // Chart-ları serverdən birbaşa gələn ilkin data ilə render edirik
            if (typeof initReportCharts === "function") {
                initReportCharts(rawServerData, "@currentCurrency");
            }
            // 🟢 Reset (Sıfırla) Düyməsinin İşlənməsi
            var resetBtn = document.getElementById("resetFilterBtn");
            if (resetBtn) {
                resetBtn.addEventListener("click", function () {
                    var startDateEl = document.getElementById("startDate");
                    var endDateEl = document.getElementById("endDate");
                    var currencyEl = document.getElementById("currencySelect");

                    if (startDateEl && startDateEl._flatpickr) startDateEl._flatpickr.clear();
                    if (endDateEl && endDateEl._flatpickr) endDateEl._flatpickr.clear();
                    if (currencyEl) currencyEl.value = "AZN";

                    if (typeof fetchReportData === "function") {
                        fetchReportData();
                    }
                });
            }
        });
    </script>
}