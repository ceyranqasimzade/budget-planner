@using budget_planner.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="az">
<head>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('budget_theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Büdcəm</title>
    <meta name="description" content="Şəxsi büdcə idarəetmə sistemi" />
    <meta name="theme-color" content="#0B4635" />
    <link rel="icon" href="~/favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <!-- 🟢 AI Chat CSS -->
    <link rel="stylesheet" href="~/assets/css/ai-chat.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="app-container">
        <!-- ================= SIDEBAR ================= -->
        <aside class="sidebar">
            <a asp-controller="Home" asp-action="Index" class="sidebar-logo">
                <i class="bi bi-wallet2"></i>
                <span>Büdcəm</span>
            </a>
            <nav class="sidebar-nav">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link @(controller == "Home" ? "active" : "")">
                            <i class="fas fa-house"></i>
                            <span>İcmal</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Transaction" asp-action="Index" class="nav-link @(controller == "Transaction" ? "active" : "")">
                            <i class="fas fa-right-left"></i>
                            <span>Əməliyyatlar</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Goal" asp-action="Index" class="nav-link @(controller == "Goal" ? "active" : "")">
                            <i class="fas fa-bullseye"></i> Hədəflər
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Report" asp-action="Index" class="nav-link @(controller == "Report" ? "active" : "")">
                            <i class="fas fa-chart-pie"></i>
                            <span>Hesabatlar</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Settings" asp-action="Index" class="nav-link @(controller == "Settings" ? "active" : "")">
                            <i class="fas fa-gear"></i>
                            <span>Parametrlər</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>
        <!-- ================= MAIN WRAPPER ================= -->
        <div class="main-wrapper">
            <!-- ================= NAVBAR ================= -->
            <header class="navbar px-4">
                <!-- Right Side -->
                <div class="navbar-actions d-flex align-items-center gap-3 ms-auto">
                    <!-- Theme -->
                    <button id="theme-toggle"
                            class="btn btn-link text-body p-0 border-0 shadow-none fs-5"
                            type="button"
                            title="Tema dəyiş">
                        <i id="theme-icon" class="bi bi-moon-stars-fill"></i>
                    </button>
                    <!-- User / Auth Section -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "İstifadəçi";
                        var avatarUrl = !string.IsNullOrEmpty(currentUser?.ProfilePicturePath)
                        ? currentUser.ProfilePicturePath
                        : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(displayName)}&background=0B4635&color=fff";

                        <div class="dropdown">
                            <a class="user-profile dropdown-toggle text-decoration-none d-flex align-items-center gap-2"
                               href="#"
                               role="button"
                               id="userDropdown"
                               data-bs-toggle="dropdown"
                               aria-expanded="false"
                               style="cursor: pointer;">
                                <img src="@avatarUrl"
                                     alt="Profil"
                                     class="avatar rounded-circle"
                                     style="width: 38px; height: 38px; object-fit: cover;" />
                                <div class="user-info d-none d-sm-block text-start">
                                    <span class="user-name d-block font-weight-bold" style="font-size: 0.9rem;">
                                        @displayName
                                    </span>
                                    <span class="user-role d-block text-muted" style="font-size: 0.75rem;">
                                        İstifadəçi
                                    </span>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                                <li>
                                    <div class="dropdown-item-text">
                                        <div class="fw-bold">@displayName</div>
                                        <div class="text-muted small">@currentUser?.Email</div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-right-from-bracket"></i>
                                            Çıxış et
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary d-flex align-items-center gap-2">
                            <i class="fa-solid fa-right-to-bracket"></i>
                            <span>Daxil ol</span>
                        </a>
                    }
                </div>
            </header>
            <!-- ================= MAIN CONTENT ================= -->
            <main class="main-content">
                <!-- 🟢 QƏŞƏNG VƏ SƏLİQƏLİ BİLDİRİŞ BLOKLARI (BURA ƏLAVƏ EDİLDİ) -->
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm border-0 d-flex align-items-center" role="alert" style="border-radius: 12px;">
                        <i class="bi bi-exclamation-octagon-fill fs-4 me-3 text-danger"></i>
                        <div>
                            <strong>Xəta!</strong> @TempData["Error"]
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm border-0 d-flex align-items-center" role="alert" style="border-radius: 12px;">
                        <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                        <div>
                            <strong>Uğurlu!</strong> @TempData["SuccessMessage"]
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
            <!-- ================= FOOTER ================= -->
            <footer class="footer">
                <small>
                    © @DateTime.Now.Year Büdcəm. Bütün hüquqlar qorunur.
                </small>
            </footer>
        </div>
    </div>
    <!-- ================= 🟢 AI CHAT WIDGET ================= -->
    <button id="aiChatToggleBtn" class="ai-chat-toggle-btn" onclick="toggleAiChat()">
        <i class="fa-solid fa-robot"></i>
        <span>AI Məsləhətçi</span>
    </button>
    <div id="aiChatContainer" class="ai-chat-container d-none">
        <div class="ai-chat-header">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-robot text-teal"></i>
                <strong style="color: #fff;">Büdcəm AI</strong>
            </div>
            <button class="ai-chat-close-btn" onclick="toggleAiChat()">&times;</button>
        </div>

        <div id="aiChatMessages" class="ai-chat-messages">
            <div class="ai-msg bot">
                Salam! Mən sizin şəxsi maliyyə köməkçinizəm. Büdcəniz, xərcləriniz və ya yığımlarınızla bağlı nə sualınız var?
            </div>
        </div>

        <div class="ai-chat-footer">
            <input type="text" id="aiUserInput" placeholder="Sualınızı daxil edin..." onkeypress="handleAiKeyPress(event)" autocomplete="off" />
            <button onclick="sendAiMessage()"><i class="fa-solid fa-paper-plane"></i></button>
        </div>
    </div>
    <!-- 1. Əsas köməkçi kitabxana (jQuery) ən yuxarıda -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- 2. UI və Digər Kitabxanalar -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- 3. Flatpickr və onun dil (lokal) faylı (ardıcıllıq qorunmaqla) -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/az.js"></script>
    <script src="~/assets/js/billTransaction.js" asp-append-version="true"></script>
    <script>
        if (typeof flatpickr !== 'undefined' && flatpickr.l10ns && flatpickr.l10ns.az) {
            flatpickr.localize(flatpickr.l10ns.az);
        }
    </script>
    <script>
        window.isUserAuthenticated = @SignInManager.IsSignedIn(User).ToString().ToLower();
    </script>
    <script src="~/assets/js/theme.js" asp-append-version="true"></script>
    <!-- 🟢 AI Chat JS -->
    <script src="~/assets/js/ai-chat.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>