<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Budget Planner</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/css/base.css" />
    <link rel="stylesheet" href="~/assets/css/layout.css" />
    <link rel="stylesheet" href="~/assets/css/components.css" />
    <link rel="stylesheet" href="~/assets/css/charts.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="app-container">
        <aside class="sidebar">
            <h2>Büdcəm</h2>
            <nav class="sidebar-nav">
                <ul>
                    <li><a href="/" class="active"><i class="fas fa-home"></i> İcmal</a></li>
                    <li><a href="#"><i class="fas fa-exchange-alt"></i> Əməliyyatlar</a></li>

                    <!-- Bura Düzəldildi: Hədəflər linki qoşuldu -->
                    <li>
                        <a asp-controller="Goal" asp-action="Index"><i class="fas fa-bullseye"></i> Hədəflər</a></li>

                    <li><a href="#"><i class="fas fa-chart-pie"></i> Hesabatlar</a></li>
                    <li><a href="#"><i class="fas fa-cog"></i> Parametrlər</a></li>
                </ul>
            </nav>
        </aside>
        <header class="navbar">
            <div class="search-bar">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Əməliyyat axtar..." />
            </div>
            <div class="navbar-actions">
                <button class="icon-btn" title="Gecə/Gündüz Rejimi">
                    <i class="fa-solid fa-moon"></i>
                </button>
                <button class="icon-btn" title="Bildirişlər">
                    <i class="fa-regular fa-bell"></i>
                    <span class="badge">3</span>
                </button>
                <div class="user-profile">
                    <img src="https://ui-avatars.com/api/?name=Ceyran+Qasimzade&background=0B4635&color=fff" alt="Profil" class="avatar" />
                    <div class="user-info">
                        <span class="user-name profile-name-text">Ceyran Qasimzade</span>
                        <span class="user-role">Premium plan</span>
                    </div>
                </div>
            </div>
        </header>
        <main class="main-content">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>