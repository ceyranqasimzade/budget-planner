@using System.Text.Json
@model IEnumerable<budget_planner.Models.Transaction>
@{
    ViewData["Title"] = "Tranzaksiyalar Paneli";

    var totalsByCurrency = Model.GroupBy(t => t.Currency ?? "AZN").Select(g => new
    {
        currency = g.Key,
        income = g.Where(t => t.IsIncome).Sum(t => t.Amount),
        expense = g.Where(t => !t.IsIncome).Sum(t => t.Amount)
    }).ToList();

    string totalsJson = JsonSerializer.Serialize(totalsByCurrency);
}
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="~/assets/css/transactions.css" asp-append-version="true" />
}
<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-dark m-0">
                <i class="fa-solid fa-wallet text-primary me-2"></i> Əməliyyatlar Paneli
            </h3>
            <p class="text-muted m-0 small">Maliyyə hərəkətlərinizi süzgəcdən keçirin, sıralayın və hesabat alın.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button onclick="exportTableToCSV('əməliyyatlar.csv')" class="btn btn-outline-success btn-action shadow-sm">
                <i class="fa-solid fa-file-excel me-1"></i> Excel
            </button>
            <button onclick="exportTableToPDF()" class="btn btn-outline-danger btn-action shadow-sm">
                <i class="fa-solid fa-file-pdf me-1"></i> PDF Yüklə
            </button>
            <button id="btnBulkDelete" onclick="bulkDeleteTransactions()" class="btn btn-danger btn-action shadow-sm d-none">
                <i class="fa-solid fa-trash-can me-1"></i> Seçilənləri Sil (<span id="selectedCount">0</span>)
            </button>
            <a asp-action="Create" class="btn btn-primary btn-action shadow-sm">
                <i class="fa-solid fa-circle-plus me-1"></i> Yeni Əməliyyat
            </a>
        </div>
    </div>
    <div class="page-card filter-section mb-4">
        <div class="row g-3">
            <div class="col-xl-3 col-md-6">
                <label class="form-label small fw-bold text-secondary"><i class="fa-solid fa-magnifying-glass me-1"></i> Canlı Axtarış</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="fa-solid fa-search"></i></span>
                    <input type="text" id="searchInp" onkeyup="filterTable()" class="form-control" placeholder="Təsvir və ya kateqoriya yazın...">
                </div>
            </div>
            <div class="col-xl-2 col-md-6">
                <label class="form-label small fw-bold text-secondary"><i class="fa-solid fa-filter me-1"></i> Əməliyyat Növü</label>
                <select id="typeFilter" onchange="filterTable()" class="form-select">
                    <option value="all">Hamısı (Gəlir & Xərc)</option>
                    <option value="income">Yalnız Gəlirlər</option>
                    <option value="expense">Yalnız Xərclər</option>
                </select>
            </div>
            <div class="col-xl-3 col-md-5">
                <label class="form-label small fw-bold text-secondary"><i class="fa-solid fa-calendar-day me-1"></i> Başlanğıc Tarixi</label>
                <input type="text" id="startDate" class="form-control date-picker bg-white" placeholder="GG.AA.İİİİ">
            </div>
            <div class="col-xl-3 col-md-5">
                <label class="form-label small fw-bold text-secondary"><i class="fa-solid fa-calendar-check me-1"></i> Bitmə Tarixi</label>
                <input type="text" id="endDate" class="form-control date-picker bg-white" placeholder="GG.AA.İİİİ">
            </div>
            <div class="col-xl-1 col-md-2 d-flex align-items-end">
                <button onclick="resetFilters()" class="btn btn-secondary w-100 py-2" title="Filtrləri Sıfırla">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </button>
            </div>
        </div>
    </div>
    <div class="row align-items-stretch mb-4">
        <div class="col-lg-4 d-flex">
            <div class="card page-card p-4 w-100 shadow-sm border-0 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark m-0 fs-6">
                        <i class="fa-solid fa-chart-pie text-warning me-2"></i> Nisbət Analizi
                    </h5>
                    <select id="chartCurrencySelector" class="form-select form-select-sm w-auto fw-bold text-primary border-primary" onchange="renderChart()">
                        <option value="AZN">AZN</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                        <option value="TRY">TRY</option>
                        <option value="RUB">RUB</option>
                        <option value="GBP">GBP</option>
                    </select>
                </div>
                <div class="d-flex justify-content-center align-items-center" style="min-height: 220px;">
                    <canvas id="myBudgetChart" data-totals='@totalsJson'></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-8 d-flex">
            <div class="card page-card p-4 w-100 d-flex flex-column justify-content-between border-0 shadow-sm bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark m-0">
                        <i class="fa-solid fa-qrcode me-2" style="color: #6f42c1;"></i> Ağıllı Qəbz Daxiletmə
                    </h5>
                    <span class="badge border px-2 py-1 small" style="color: #6f42c1; background-color: #f1e9fc; border-color: #dbadeb;">Fiskal / QR</span>
                </div>
                <div class="row g-3 align-items-center my-auto">
                    <div class="col-md-7 border-end pe-md-4">
                        <p class="text-muted small mb-3">12 simvollu **Fiskal ID (PIN)** yazın və ya kameradan **QR kodu** oxudun.</p>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary mb-1">Fiskal ID (PIN Kod)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted fw-bold">#</span>
                                <input type="text" id="fiskalIdInp" class="form-control text-uppercase fw-bold text-dark" placeholder="Y7R5T9E2W1Q8" maxlength="12" style="letter-spacing: 1px; font-size: 0.95rem;">
                                <button onclick="processFiskalId()" class="btn text-white px-3" style="background-color: #6f42c1;" type="button">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-outline-purple btn-sm py-2 fw-semibold" style="color: #6f42c1; border-color: #6f42c1; background: transparent;" onclick="startQRScanner()">
                                <i class="fa-solid fa-camera me-2"></i> QR Kodu Skan Et
                            </button>
                        </div>
                    </div>
                    <div class="col-md-5 ps-md-4 text-center">
                        <label class="form-label small fw-bold text-secondary mb-2 d-block">Və ya Şəkil Kimi Yüklə</label>
                        <div class="receipt-drop-zone d-flex flex-column align-items-center justify-content-center p-3 text-center"
                             style="border: 2px dashed #dbadeb; border-radius: 12px; background-color: #f8f9fa; cursor: pointer; min-height: 110px; transition: all 0.2s ease;">
                            <i class="fa-solid fa-cloud-arrow-up fs-4 text-purple mb-1" style="color: #6f42c1;"></i>
                            <span class="fw-semibold text-dark small" style="font-size: 0.8rem;">Çəki bura sürükləyin</span>
                            <input type="file" id="receiptFileInp" accept="image/*,application/pdf" class="d-none">
                        </div>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top">
                    <div class="d-flex gap-2 overflow-auto pb-1">
                        <div class="d-flex align-items-center bg-light border rounded px-2 py-1 text-nowrap" style="font-size: 0.8rem;">
                            <i class="fa-solid fa-ticket text-purple me-2" style="color: #6f42c1;"></i>
                            ID: <strong class="ms-1 text-dark">A9X7...B2W1</strong>
                            <span class="badge bg-success bg-opacity-10 text-success ms-2">12.50 ₼</span>
                        </div>
                        <div class="d-flex align-items-center bg-light border rounded px-2 py-1 text-nowrap" style="font-size: 0.8rem;">
                            <i class="fa-solid fa-image text-muted me-2"></i> market_cek.png
                            <span class="badge bg-danger bg-opacity-10 text-danger ms-2">45.00 ₼</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <table id="transactionTable" class="table table-hover align-middle m-0 border overflow-hidden" style="border-radius: 8px;">
        <thead class="premium-thead">
            <tr>
                <th class="text-center" style="width: 5%">
                    <input type="checkbox" id="selectAll" onclick="toggleSelectAll(this)" class="form-check-input">
                </th>
                <th onclick="sortTable(1, 'date')" class="text-center sortable-header text-nowrap" style="width: 15%; cursor: pointer;">
                    Tarix <i class="fa-solid fa-sort ms-1"></i>
                </th>
                <th onclick="sortTable(2, 'text')" class="sortable-header text-nowrap" style="width: 25%; cursor: pointer;">
                    Təsvir <i class="fa-solid fa-sort ms-1"></i>
                </th>
                <th onclick="sortTable(3, 'text')" class="text-center sortable-header text-nowrap" style="width: 15%; cursor: pointer;">
                    Kateqoriya <i class="fa-solid fa-sort ms-1"></i>
                </th>
                <th onclick="sortTable(4, 'number')" class="text-end sortable-header text-nowrap" style="width: 15%; cursor: pointer;">
                    Məbləğ <i class="fa-solid fa-sort ms-1"></i>
                </th>
                <th onclick="sortTable(5, 'text')" class="text-center sortable-header text-nowrap" style="width: 10%; cursor: pointer;">
                    Status <i class="fa-solid fa-sort ms-1"></i>
                </th>
                <th class="text-center text-nowrap" style="width: 15%">İdarəetmə</th>
            </tr>
        </thead>
        <tbody id="tableBody">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr data-type="@(item.IsIncome ? "income" : "expense")" data-timestamp="@item.Date.ToString("yyyy-MM-dd")">
                        <td class="text-center">
                            <input type="checkbox" name="rowSelect" value="@item.Id" onclick="updateBulkDeleteButton()" class="form-check-input row-checkbox">
                        </td>
                        <td class="text-secondary text-center small fw-bold">@item.Date.ToString("dd MMM yyyy")</td>
                        <td class="fw-semibold text-dark text-wrap">@item.Description</td>
                        <td class="text-center align-middle">
                            @item.Category
                        </td>
                        <td class="text-end fw-bold @(item.IsIncome ? "text-success" : "text-danger")" data-amount="@item.Amount" data-currency="@item.Currency">
                            @(item.IsIncome ? "+" : "-") @item.Amount.ToString("N2")
                            <span class="currency-symbol ms-1">
                                @switch (item.Currency)
                                {
                                    case "USD":
                                        <text>$</text>
                                        break;
                                    case "EUR":
                                        <text>€</text>
                                        break;
                                    case "TRY":

                                        <text>₺</text>
                                        break;
                                    case "RUB":
                                        <text>₽</text>
                                        break;
                                    case "GBP":
                                        <text>£</text>
                                        break;
                                    default:
                                        <text>₼</text>
                                        break;
                                }
                            </span>
                        </td>
                        <td class="text-center align-middle">
                            <span style="display: inline-block; padding: 4px 8px; background-color: #f1f3f5; border-radius: 6px; color: #495057; font-size: 0.85em;">
                                @item.Status
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Redaktə et">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger"
                                   onclick="return confirm('Silmək istədiyinizdən əminsiniz?');" title="Sil">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-5">
                        <i class="fa-solid fa-folder-open fs-1 mb-3 text-secondary"></i>
                        <h5 class="fw-normal">Hələ heç bir əməliyyat yoxdur.</h5>
                        <p class="small">Yuxarıdakı "Yeni Əməliyyat" düyməsinə klikləyərək ilk qeydinizi yaradın.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="pagination-container mt-3 d-flex justify-content-between align-items-center">
        <div class="rows-per-page">
            <select id="rowsPerPage" class="form-select form-select-sm text-secondary" style="border-radius: 6px; cursor: pointer; width: auto; display: inline-block;">
                <option value="10">10 sətir</option>
                <option value="25">25 sətir</option>
                <option value="50">50 sətir</option>
                <option value="100">100 sətir</option>
            </select>
        </div>
        <div class="pagination-controls d-flex gap-1 align-items-center">
            <button class="btn btn-sm btn-outline-secondary disabled" title="Əvvəlki">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button class="btn btn-sm btn-primary">1</button>
            <button class="btn btn-sm btn-outline-secondary">2</button>
            <button class="btn btn-sm btn-outline-secondary">3</button>
            <span class="text-secondary mx-1">...</span>
            <button class="btn btn-sm btn-outline-secondary">5</button>
            <button class="btn btn-sm btn-outline-secondary" title="Növbəti">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/az.js"></script>
    <script src="~/assets/js/budgetChart.js" asp-append-version="true"></script>
    <script src="~/assets/js/transactionManagement.js" asp-append-version="true"></script>
}