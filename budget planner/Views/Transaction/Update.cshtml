@model budget_planner.Models.Transaction

@{
    ViewData["Title"] = "Əməliyyatı Redaktə Et";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
}

<div class="container-fluid py-4">

    <div class="card page-card shadow-sm border-0"
         style="max-width:600px;margin:0 auto;border-radius:12px;">

        <div class="card-header text-white"
             style="background-color:#1b5e20;border-radius:12px 12px 0 0;">
            <h4 class="mb-0 fw-bold py-1">
                <i class="fa-solid fa-pen-to-square me-2"></i>
                Əməliyyatı Redaktə Et
            </h4>
        </div>

        <div class="card-body p-4">

            <form asp-action="Update" method="post">
                @Html.AntiForgeryToken()

                <!-- 9. Hidden ID (POST zamanı hansı qeydin yenilənəcəyini müəyyən edir) -->
                <input type="hidden" asp-for="Id" />

                <!-- DATE -->
                <div class="mb-3">
                    <label asp-for="Date"
                           class="form-label fw-bold text-secondary">
                        Tarix
                    </label>

                    <input asp-for="Date"
                           type="text"
                           id="transactionDate"
                           class="form-control"
                           placeholder="İİİİ-AA-GG"
                           required />

                    <!-- 1. Date Validation -->
                    <span asp-validation-for="Date"
                          class="text-danger"></span>
                </div>

                <!-- DESCRIPTION -->
                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label fw-bold text-secondary">
                        Təsvir
                    </label>

                    <input asp-for="Description"
                           class="form-control"
                           placeholder="Məsələn: Maaş, Market..." />

                    <!-- 1. Description Validation -->
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="row">

                    <!-- CATEGORY -->
                    <div class="col-md-5 mb-3">
                        <label asp-for="CategoryId"
                               class="form-label fw-bold text-secondary">
                            Kateqoriya
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="ViewBag.Categories"
                                class="form-select">
                            <option value="">
                                Kateqoriya seçin
                            </option>
                        </select>

                        <!-- 4. Category Validation -->
                        <span asp-validation-for="CategoryId"
                              class="text-danger"></span>
                    </div>

                    <!-- AMOUNT -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Amount"
                               class="form-label fw-bold text-secondary">
                            Məbləğ
                        </label>

                        <!-- 3. min="0.01" tətbiqi -->
                        <input asp-for="Amount"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control"
                               placeholder="0.00" />

                        <!-- 1. Amount Validation -->
                        <span asp-validation-for="Amount"
                              class="text-danger"></span>
                    </div>

                    <!-- CURRENCY -->
                    <div class="col-md-3 mb-3">
                        <label asp-for="Currency"
                               class="form-label fw-bold text-secondary">
                            Valyuta
                        </label>

                        <!-- RUB və GBP də daxil olmaqla tam siyahı -->
                        <select asp-for="Currency"
                                class="form-select">
                            <option value="AZN">₼ AZN</option>
                            <option value="USD">$ USD</option>
                            <option value="EUR">€ EUR</option>
                            <option value="TRY">₺ TRY</option>
                            <option value="RUB">₽ RUB</option>
                            <option value="GBP">£ GBP</option>
                        </select>
                    </div>

                </div>

                <!-- INCOME TYPE -->
                <div class="mb-4">
                    <label asp-for="IsIncome"
                           class="form-label fw-bold text-secondary">
                        Əməliyyat növü
                    </label>

                    <select asp-for="IsIncome"
                            class="form-select">
                        <option value="true">Gəlir (+)</option>
                        <option value="false">Xərc (-)</option>
                    </select>
                </div>

                <!-- STATUS -->
                <div class="mb-4">
                    <label asp-for="Status"
                           class="form-label fw-bold text-secondary">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">
                        <option value="Tamamlandı">Tamamlandı</option>
                        <option value="Gözləyir">Gözləyir</option>
                        <option value="Ləğv edildi">Ləğv edildi</option>
                    </select>

                    <!-- 5. Status Validation -->
                    <span asp-validation-for="Status"
                          class="text-danger"></span>
                </div>

                <!-- BUTTONS -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Geri qayıt
                    </a>

                    <button type="submit"
                            class="btn px-4 fw-bold text-white"
                            style="background-color:#1b5e20;">
                        <i class="fa-solid fa-arrows-rotate me-1"></i>
                        Yenilə və Saxla
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <!-- 1. Client-Side Validation Əlavə Edildi -->
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/az.js"></script>

    <!-- 7. Məntiq olaraq Update üçün ayrılmış JS faylı link olundu -->
    <script src="~/assets/js/updateTransaction.js"
            asp-append-version="true"></script>
}