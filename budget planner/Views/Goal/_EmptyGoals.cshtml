<section class="empty-state-wrapper text-center my-5">
    <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto empty-glass-card" style="max-width: 550px;">
        <!-- İkon Dairəsi -->
        <div class="empty-icon-circle mb-4 mx-auto d-flex align-items-center justify-content-center bg-emerald-subtle rounded-circle" style="width: 80px; height: 80px;">
            <i class="bi bi-bullseye fs-1 text-emerald"></i>
        </div>

        <!-- Mətn Bölməsi -->
        <h4 class="fw-bold mb-2 text-dark">Hələ heç bir maliyyə hədəfi yoxdur</h4>
        <p class="text-muted mb-4 small">
            İlk hədəfinizi yaradın, qənaət etməyə başlayın və xəyallarınıza addım-addım yaxınlaşın.
        </p>

        <!-- Keçid Düyməsi (Ayrıca Səhifəyə Yönləndirmə) -->
        <div class="d-inline-block">
            <a asp-controller="Goal" asp-action="Create" class="btn btn-emerald text-white rounded-3 px-4 py-2-5 fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>İlk Hədəfinizi Yaradın
            </a>
        </div>

        <!-- VƏ YA Modal İstifadə Edirsinizsə (Aşağıdakı düyməni aktiv edə bilərsiniz):
        <button type="button" class="btn btn-emerald text-white rounded-3 px-4 py-2-5 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#newGoalModal">
            <i class="bi bi-plus-lg me-2"></i>İlk Hədəfinizi Yaradın
        </button>
        -->
    </div>
</section>