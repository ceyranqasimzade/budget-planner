@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Maliyyə Hədəflərim</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Sənin öz CSS faylın -->
    <link rel="stylesheet" href="~/assets/css/goals.css" />
</head>
<body class="bg-light">

    <div class="container py-4">
        <!-- Yuxarı Başlıq və Düymə -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark m-0">Maliyyə Hədəfləri</h3>
                <p class="text-muted m-0 small">Gələcək planlarınız üçün qənaət edin və irəliləyişinizi izləyin</p>
            </div>
            <button class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 style-btn">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Hədəf Yarat</span>
            </button>
        </div>

        <!-- Statistik İcmal Kartları -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="goal-stat-card">
                    <div class="stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-bullseye"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Ümumi Hədəf Məbləği</span>
                        <h4 class="fw-bold text-dark m-0">$18,500.00</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="goal-stat-card">
                    <div class="stat-icon bg-success-subtle text-success">
                        <i class="bi bi-piggy-bank-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Toplanan Məbləğ</span>
                        <h4 class="fw-bold text-dark m-0">$5,700.00</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="goal-stat-card">
                    <div class="stat-icon bg-warning-subtle text-warning">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Aktiv Hədəflər</span>
                        <h4 class="fw-bold text-dark m-0">3 Adət</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hədəf Kartları -->
        <div class="row g-4">
            <!-- Hədəf 1: Maşın -->
            <div class="col-md-6 col-lg-4">
                <div class="goal-card">
                    <div class="goal-card-header">
                        <div class="goal-avatar bg-primary-subtle text-primary">
                            <i class="bi bi-car-front-fill"></i>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mt-3 mb-1">Yeni Maşın</h5>
                    <span class="text-muted small d-block mb-3"><i class="bi bi-calendar3 me-1"></i> 15 Noyabr 2026-dək</span>

                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-muted">Yığılan: <strong class="text-dark">$4,500</strong></span>
                        <span class="small fw-bold text-primary">37.5%</span>
                    </div>

                    <div class="progress custom-goal-progress mb-3">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 37.5%"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="small text-muted">Hədəf: <strong>$12,000</strong></span>
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3">+ Pul Əlavə Et</button>
                    </div>
                </div>
            </div>

            <!-- Hədəf 2: Səyahət -->
            <div class="col-md-6 col-lg-4">
                <div class="goal-card">
                    <div class="goal-card-header">
                        <div class="goal-avatar bg-success-subtle text-success">
                            <i class="bi bi-airplane-fill"></i>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mt-3 mb-1">Avropa Səyahəti</h5>
                    <span class="text-muted small d-block mb-3"><i class="bi bi-calendar3 me-1"></i> 20 Avqust 2026-dək</span>

                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-muted">Yığılan: <strong class="text-dark">$1,200</strong></span>
                        <span class="small fw-bold text-success">40%</span>
                    </div>

                    <div class="progress custom-goal-progress mb-3">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 40%"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="small text-muted">Hədəf: <strong>$3,000</strong></span>
                        <button class="btn btn-sm btn-outline-success rounded-pill px-3">+ Pul Əlavə Et</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>