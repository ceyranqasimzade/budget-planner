@model budget_planner.ViewModels.GoalsVM
@{
    ViewData["Title"] = "Mənim Hədəflərim";
    ViewData["PageCss"] = "pages/goals.css"; // _Layout.cshtml-də dynamic yükdəmə üçün
}

<!-- BAŞLIQ HİSSƏSİ -->
<header class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">Xəyallarınıza Doğru</h1>
        <p class="text-muted">Maliyyə hədəflərinizi planlaşdırın və izləyin</p>
    </div>
    <button class="btn btn-primary custom-btn" data-bs-toggle="modal" data-bs-target="#newGoalModal">
        <i class="fas fa-plus me-2"></i> Yeni Hədəf Yarat
    </button>
</header>

<!-- MOTİVASİYA BLOKU (SSR - Server Side Rendered) -->
<section class="motivation-banner mb-5">
    <div class="motivation-content">
        <i class="fas fa-quote-left quote-icon-large"></i>
        <h2 class="quote-text">@Model.Quote</h2>
        <p class="quote-author">@Model.Author</p>
    </div>
</section>

<!-- DİNAMİK HİSSƏ (Sadələşdirilmiş if yoxlaması) -->
@if (Model.Goals.Any())
{
    <section id="active-goals-section" class="row g-4 mb-4">
        <div class="col-12 mb-2">
            <h4 class="section-title">Aktiv Hədəflərim</h4>
        </div>

        @foreach (var goal in Model.Goals)
        {
            <partial name="_GoalCard" model="goal" />
        }
    </section>
}
else
{
    <partial name="_EmptyGoals" />
}

@section Scripts {
    <script src="~/js/pages/goals.js" asp-append-version="true"></script>
}