@model budget_planner.ViewModels.GoalVM

<div class="col-12 col-md-6 col-lg-4 mb-4">
    <div class="card h-100 goal-card @(Model.IsCompleted ? "completed-goal" : "") border-0 shadow-sm rounded-4 border-top border-4 border-@Model.ColorClass">
        <div class="card-body p-4 d-flex flex-column justify-content-between">
            <div>
                <!-- Başlıq, İkon və Faiz -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="goal-icon bg-@Model.ColorClass text-white rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                            <i class="bi @(string.IsNullOrEmpty(Model.IconClass) ? "bi-bullseye" : Model.IconClass) fs-4"></i>
                        </div>
                        <div>
                            <h5 class="goal-title fw-bold mb-1">
                                <a asp-controller="Goal" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark hover-emerald">
                                    @Model.Name
                                </a>
                            </h5>
                            @if (Model.IsCompleted)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                                    <i class="bi bi-check-circle-fill me-1"></i>Tamamlandı 🎉
                                </span>
                            }
                        </div>
                    </div>
                    <span class="goal-percentage fw-bold text-@Model.ColorClass fs-5">@Model.Percentage%</span>
                </div>

                <!-- Animated Progress Bar -->
                <div class="progress custom-progress mb-3 rounded-pill" style="height: 10px;">
                    <div class="progress-bar animated-bar bg-@Model.ColorClass rounded-pill"
                         role="progressbar"
                         data-width="@Model.Percentage%"
                         style="width: 0%;"
                         aria-valuenow="@Model.Percentage"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>

                <!-- 3 Sütunlu Statistika: Yığılıb | Hədəf | Qalıb -->
                <div class="goal-stats row text-center my-3 py-2 bg-light rounded-3 g-0">
                    <div class="col-4 border-end">
                        <span class="stat-label d-block text-muted small">Yığılıb</span>
                        <span class="stat-value fw-bold text-success">@Model.CurrencySymbol@Model.CurrentAmount.ToString("N0")</span>
                    </div>
                    <div class="col-4 border-end">
                        <span class="stat-label d-block text-muted small">Hədəf</span>
                        <span class="stat-value fw-bold text-dark">@Model.CurrencySymbol@Model.TargetAmount.ToString("N0")</span>
                    </div>
                    <div class="col-4">
                        <span class="stat-label d-block text-muted small">Qalıb</span>
                        <span class="stat-value fw-bold text-secondary">@Model.CurrencySymbol@Model.RemainingAmount.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <!-- Alt Müddət və Action Düymələri -->
            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                    <i class="bi bi-clock-history me-1 text-muted"></i>
                    @(Model.MonthsRemaining > 0 ? $"{Model.MonthsRemaining} ay qaldı" : "Müddətsiz / Çatıb")
                </span>

                <div class="goal-actions d-flex gap-2">
                    <!-- Redaktə Düyməsi -->
                    <a asp-controller="Goal" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary rounded-3" title="Redaktə et">
                        <i class="bi bi-pencil-fill"></i>
                    </a>

                    <!-- Pul Əlavə Et Düyməsi (Modal Çağırışı) -->
                    <button type="button" class="btn btn-sm btn-outline-success rounded-3" title="Pul əlavə et" data-bs-toggle="modal" data-bs-target="#addFundsModal-@Model.Id">
                        <i class="bi bi-cash-coin"></i>
                    </button>

                    <!-- Sil Düyməsi -->
                    <form asp-action="Delete" asp-controller="Goal" method="post" class="d-inline" onsubmit="return confirm('Bu hədəfi silmək istədiyinizə əminsiniz?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Sil">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>