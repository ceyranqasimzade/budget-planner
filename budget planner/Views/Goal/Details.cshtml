@model budget_planner.ViewModels.GoalVM

@{
    ViewData["Title"] = "Hədəf Ətraflı";

    // Məntiqi və riyazi hesablamalar
    var percent = Model.TargetAmount > 0 ? (Model.CurrentAmount / Model.TargetAmount) * 100 : 0;
    percent = percent > 100 ? 100 : percent;
    var isCompleted = Model.CurrentAmount >= Model.TargetAmount;
    var remainingAmount = Model.TargetAmount > Model.CurrentAmount ? Model.TargetAmount - Model.CurrentAmount : 0;

    // Bitiş tarixi və qalan gün hesablanması
    int? daysLeft = null;
    bool isExpired = false;
    if (Model.Deadline.HasValue)
    {
        var diff = (Model.Deadline.Value.Date - DateTime.Now.Date).Days;
        daysLeft = diff;
        if (diff < 0 && !isCompleted)
        {
            isExpired = true;
        }
    }
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/goal.css" asp-append-version="true" />
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <!-- Başlıq Və Yuxarı Naviqasiya -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
                <div>
                    <h3 class="fw-bold mb-1">
                        <i class="bi @(string.IsNullOrEmpty(Model.IconClass) ? "bi-bullseye" : Model.IconClass) text-emerald me-2"></i>@Model.Name
                    </h3>
                    <p class="text-muted small mb-0">Hədəfinizin cari vəziyyəti və yığım göstəriciləri.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3">
                        <i class="bi bi-arrow-left me-1"></i> Geri Qayıt
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark rounded-3 px-3 fw-semibold">
                        <i class="bi bi-pencil me-1"></i> Düzəliş Et
                    </a>
                </div>
            </div>

            <!-- Əsas Detal Kartı -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 @(isCompleted ? "completed-goal" : "")">

                <!-- Status Və Valyuta Nişanları -->
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                            <i class="bi bi-currency-exchange me-1"></i>@Model.Currency
                        </span>

                        @if (isCompleted)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
                                <i class="bi bi-check-circle-fill me-1"></i>Tamamlandı
                            </span>
                        }
                        else if (isExpired)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-6">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Müddəti Bitib
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
                                <i class="bi bi-arrow-repeat me-1"></i>Davam Edir
                            </span>
                        }
                    </div>

                    <div class="text-end">
                        <small class="text-muted d-block">Bitiş Tarixi</small>
                        @if (Model.Deadline.HasValue)
                        {
                            <span class="fw-bold @(isExpired ? "text-danger" : "text-dark")">
                                <i class="bi bi-calendar-event me-1"></i>@Model.Deadline.Value.ToString("dd.MM.yyyy")
                                @if (!isCompleted)
                                {
                                    <small class="text-muted ms-1">(@(daysLeft < 0 ? $"{Math.Abs(daysLeft.Value)} gün keçib" : $"{daysLeft} gün qalıb"))</small>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="fw-bold text-dark">Qeyd edilməyib</span>
                        }
                    </div>
                </div>

                <!-- Animasiyalı Proqres Çubuğu -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center small fw-bold mb-2">
                        <span class="text-muted fs-6">Ümumi Yığım Proqresi</span>
                        <span class="text-emerald fs-5">@percent.ToString("F0")%</span>
                    </div>
                    <div class="progress rounded-pill" style="height: 14px;">
                        <div class="progress-bar bg-emerald rounded-pill animated-bar"
                             role="progressbar"
                             style="width: 0%;"
                             data-width="@percent.ToString("F0")%"
                             aria-valuenow="@percent"
                             aria-valuemin="0"
                             aria-valuemax="100"></div>
                    </div>
                </div>

                <!-- Məbləğ Statistikası Kartları -->
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded-4 text-center border">
                            <small class="text-muted d-block mb-1">Hədəf Məbləğ</small>
                            <h4 class="fw-bold text-dark mb-0">@Model.TargetAmount.ToString("N2") @Model.Currency</h4>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded-4 text-center border">
                            <small class="text-muted d-block mb-1">Toplanan Məbləğ</small>
                            <h4 class="fw-bold text-emerald mb-0">@Model.CurrentAmount.ToString("N2") @Model.Currency</h4>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded-4 text-center border">
                            <small class="text-muted d-block mb-1">Qalan Məbləğ</small>
                            <h4 class="fw-bold text-secondary mb-0">@remainingAmount.ToString("N2") @Model.Currency</h4>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Alt Silmə Və Düzəliş Zolağı -->
            <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 shadow-sm border">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu hədəfi silmək istədiyinizə əminsiniz?');">
                    <button type="submit" class="btn btn-outline-danger rounded-3 px-3">
                        <i class="bi bi-trash me-1"></i> Sil
                    </button>
                </form>

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-emerald text-white rounded-3 px-4 fw-semibold">
                    <i class="bi bi-pencil-square me-1"></i> Düzəliş Et
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/goal.js" asp-append-version="true"></script>
}