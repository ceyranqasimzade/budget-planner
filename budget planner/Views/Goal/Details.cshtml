@model budget_planner.ViewModels.GoalVM

@{
    ViewData["Title"] = "Hədəf Ətraflı";
    // İkon seçimi
    var icon = string.IsNullOrEmpty(Model.IconClass) ? "bi-bullseye" : Model.IconClass;
    // Məntiqi və riyazi hesablamalar
    var percent = Model.TargetAmount > 0 ? (Model.CurrentAmount / Model.TargetAmount) * 100 : 0;
    var displayPercent = percent > 100 ? 100 : percent;
    var isCompleted = Model.CurrentAmount >= Model.TargetAmount;
    var remainingAmount = Model.TargetAmount > Model.CurrentAmount ? Model.TargetAmount - Model.CurrentAmount : 0;
    // Bitiş tarixi və qalan gün hesablanması
    int? daysLeft = null;
    bool isExpired = false;
    if (Model.Deadline.HasValue)
    {
        var diff = (Model.Deadline.Value.Date - DateTime.Now.Date).Days;
        daysLeft = diff;
        if (diff < 0 && !isCompleted)
        {
            isExpired = true;
        }
    }
}
@section Styles {
    <link rel="stylesheet" href="~/assets/css/goal.css" asp-append-version="true" />
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <!-- Yuxarı Naviqasiya Və Əməliyyatlar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
                <div>
                    <h3 class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill text-emerald"></i> Hədəf Təfərrüatları
                    </h3>
                    <p class="text-muted small mb-0">Hədəfinizin cari vəziyyəti, yığım proqresi və statistik göstəriciləri.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3">
                        <i class="bi bi-arrow-left me-1"></i> Geri Qayıt
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark rounded-3 px-3 fw-semibold">
                        <i class="bi bi-pencil me-1"></i> Düzəliş Et
                    </a>
                </div>
            </div>
            <!-- ƏSAS HƏDƏF KARTI -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 border-top border-4 border-emerald @(isCompleted ? "completed-goal" : "")">
                <!-- Kart Başlığı: İkon, Ad Və Faiz -->
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <!-- Dynamic Soft Icon Box -->
                        <div class="goal-icon-box bg-emerald-subtle text-emerald border border-emerald-subtle rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 60px; height: 60px; font-size: 1.75rem; flex-shrink: 0;">
                            <i class="bi @icon"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1 text-dark">@Model.Name</h4>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="badge bg-light text-dark border px-2 py-1 small">
                                    <i class="bi bi-currency-exchange me-1"></i>@Model.Currency
                                </span>
                                @if (isCompleted)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                        <i class="bi bi-check-circle-fill me-1"></i>Tamamlandı
                                    </span>
                                }
                                else if (isExpired)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 small">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Müddəti Bitib
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                                        <i class="bi bi-arrow-repeat me-1"></i>Davam Edir
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="d-block text-muted small fw-semibold">Yığım Faizi</span>
                        <span class="fs-2 fw-bold text-emerald">@percent.ToString("F0")%</span>
                    </div>
                </div>
                <!-- Proqres Çubuğu -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center small fw-semibold mb-2">
                        <span class="text-muted">Ümumi Yığım Proqresi</span>
                        <span class="text-dark fw-bold">@Model.CurrentAmount.ToString("N2") / @Model.TargetAmount.ToString("N2") @Model.Currency</span>
                    </div>
                    <div class="progress rounded-pill" style="height: 14px; background-color: #e9ecef;">
                        <div class="progress-bar bg-emerald rounded-pill animated-bar"
                             role="progressbar"
                             style="width: 0%;"
                             data-width="@displayPercent.ToString("F0")%"
                             aria-valuenow="@displayPercent"
                             aria-valuemin="0"
                             aria-valuemax="100"></div>
                    </div>
                </div>
                <!-- Məbləğ Statistikası Kartları -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded-4 text-center border h-100 d-flex flex-column justify-content-center">
                            <small class="text-muted d-block mb-1 font-monospace text-uppercase">Hədəf Məbləğ</small>
                            <h4 class="fw-bold text-dark mb-0">@Model.TargetAmount.ToString("N2") <small class="fs-6 text-muted">@Model.Currency</small></h4>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-emerald-subtle rounded-4 text-center border border-emerald-subtle h-100 d-flex flex-column justify-content-center">
                            <small class="text-emerald d-block mb-1 font-monospace text-uppercase fw-semibold">Toplanan Məbləğ</small>
                            <h4 class="fw-bold text-emerald mb-0">@Model.CurrentAmount.ToString("N2") <small class="fs-6">@Model.Currency</small></h4>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded-4 text-center border h-100 d-flex flex-column justify-content-center">
                            <small class="text-muted d-block mb-1 font-monospace text-uppercase">Qalan Məbləğ</small>
                            <h4 class="fw-bold text-secondary mb-0">@remainingAmount.ToString("N2") <small class="fs-6 text-muted">@Model.Currency</small></h4>
                        </div>
                    </div>
                </div>
                <!-- Bitiş Tarixi Melumat Paneli -->
                <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-calendar3 text-muted fs-5"></i>
                        <div>
                            <span class="d-block text-muted small lh-1">Bitiş Tarixi (Deadline)</span>
                            <strong class="text-dark">
                                @(Model.Deadline.HasValue? Model.Deadline.Value.ToString("dd MMMM yyyy") : "Tarix qeyd edilməyib")
                            </strong>
                        </div>
                    </div>
                    @if (Model.Deadline.HasValue && !isCompleted)
                    {
                        <div>
                            @if (isExpired)
                            {
                                <span class="badge bg-danger text-white rounded-pill px-3 py-2">
                                    <i class="bi bi-clock-history me-1"></i> @(Math.Abs(daysLeft.Value)) gün gecikir
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-white text-dark border rounded-pill px-3 py-2 shadow-sm">
                                    <i class="bi bi-hourglass-split me-1 text-emerald"></i> @daysLeft gün qalıb
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
            <!-- Alt Silmə Və Düzəliş Zolağı -->
            <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 shadow-sm border">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="confirmDelete(event, this);">
                    <button type="submit" class="btn btn-outline-danger rounded-3 px-3">
                        <i class="bi bi-trash me-1"></i> Hədəfi Sil
                    </button>
                </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/assets/js/goal.js" asp-append-version="true"></script>
}