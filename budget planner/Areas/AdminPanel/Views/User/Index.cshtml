@model IEnumerable<budget_planner.Models.ApplicationUser>

@{
    ViewData["Title"] = "İstifadəçilər";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">İstifadəçilər</h4>

    <a asp-action="Create"
       class="btn btn-primary create-user-btn">
        <i class="mdi mdi-account-plus"></i>
        Yeni istifadəçi yarat
    </a>
</div>
<!-- CƏDVƏL -->
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="bg-light">
            <tr>
                <th>#</th>
                <th>İstifadəçi</th>
                <th>E-poçt</th>
                <th>Qeydiyyat Tarixi</th>
                <th>Status</th>
                <th class="text-center">İdarəetmə</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int count = 1;
                foreach (var user in Model)
                {
                    <tr>
                        <td>@count</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle me-2 d-flex align-items-center justify-content-center rounded-circle overflow-hidden"
                                     style="width:36px;height:36px;background:#e0f2fe;color:#0369a1;">

                                    @if (!string.IsNullOrEmpty(user.ProfilePicturePath))
                                    {
                                        <img src="@user.ProfilePicturePath"
                                             alt="Profile"
                                             style="width:100%;height:100%;object-fit:cover;">
                                    }
                                    else
                                    {
                                        @(string.IsNullOrEmpty(user.FullName)
                                                                    ? "U"
                                                                    : user.FullName.Substring(0, 1).ToUpper())
                                    }

                                </div>

                                <div>
                                    <span class="font-weight-bold d-block text-dark">
                                        @user.FullName
                                    </span>
                                    <small class="text-muted">
                                        @($"@{user.UserName}")
                                    </small>
                                </div>
                            </div>
                        </td>

                        <td>@user.Email</td>

                        <td>@user.CreatedDate.ToString("dd MMM yyyy")</td>

                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success text-white">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge bg-danger text-white">Bloklanıb</span>
                            }
                        </td>

                        <td class="text-center">
                            <!-- Redaktə -->
                            <a asp-action="Update"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-primary rounded-circle action-btn"
                               title="Redaktə et">
                                <i class="mdi mdi-pencil"></i>
                            </a>

                            <!-- Status -->
                            <a asp-action="ToggleStatus"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-warning rounded-circle action-btn"
                               title="Aktiv / Blokla">
                                <i class="mdi mdi-lock"></i>
                            </a>

                            <!-- Sil -->
                            <a asp-action="Delete"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-danger rounded-circle action-btn"
                               title="Sil"
                               onclick="return confirm('Bu istifadəçini silməyə əminsiniz?');">
                                <i class="mdi mdi-delete"></i>
                            </a>
                        </td>
                    </tr>

                    count++;
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        Sistemdə heç bir istifadəçi tapılmadı.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<style>
    .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 !important;
        margin: 0 3px;
        border-radius: 6px;
        transition: all .3s ease;
        font-size: 17px;
    }

        .action-btn:hover {
            transform: translateY(-2px);
        }

    .btn-outline-primary:hover {
        color: white;
    }

    .btn-outline-warning:hover {
        color: white;
    }

    .btn-outline-danger:hover {
        color: white;
    }

    .create-user-btn {
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: .3s ease;
    }

        .create-user-btn:hover {
            transform: translateY(-2px);
        }
</style>