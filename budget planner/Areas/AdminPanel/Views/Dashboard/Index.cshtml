<div class="container-fluid p-4">

    <!-- Xoş gəldiniz Banneri -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card text-white p-4 shadow-sm border-0 rounded-4 position-relative overflow-hidden"
                 style="background: linear-gradient(135deg, #0A192F 0%, #1E3A8A 100%);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h2 class="fw-bold mb-2 d-flex align-items-center gap-2">
                            Xoş gəldiniz, Admin!                          
                        </h2>
                        <p class="mb-0 opacity-75 fs-6">"Büdcəm" İdarəetmə Panelinə uğurla daxil oldunuz. Aşağıdakı kartlar vasitəsilə sürətli keçid edə bilərsiniz.</p>
                    </div>
                    <div class="d-none d-md-block opacity-25 me-3">
                        <svg width="70" height="70" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sürətli Keçid Kartları (2-li Grid) -->
    <div class="row g-4">

        <!-- Kart 1: İstifadəçilər Siyahısı -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 rounded-3 p-3">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3">
                                <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8zm-7.978-1A4.001 4.001 0 0 1 12 10c4.42 0 8 1.79 8 4v1H7.022zM11 7a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                                </svg>
                            </div>
                            <h5 class="fw-bold mb-0">İstifadəçilər</h5>
                        </div>
                        <p class="text-muted small">Qeydiyyatdan keçmiş bütün istifadəçilərə baxın, statuslarını dəyişin və ya idarə edin.</p>
                    </div>
                    <a asp-controller="User" asp-action="Index" class="btn btn-primary w-100 mt-3 rounded-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                        Siyahıya Bax
                        <!-- Ox (Arrow Right) İkonu -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- Kart 2: Yeni İstifadəçi Əlavə Et -->
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 rounded-3 p-3">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 me-3">
                                <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zm.5-5v1.5H14.5a.5.5 0 0 1 0 1H13V15a.5.5 0 0 1-1 0v-1.5H10.5a.5.5 0 0 1 0-1H12V11a.5.5 0 0 1 1 0z" />
                                    <path d="M11 5a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM8 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
                                </svg>
                            </div>
                            <h5 class="fw-bold mb-0">Yeni İstifadəçi</h5>
                        </div>
                        <p class="text-muted small">Sistemə yeni istifadəçi və ya administrator hesabı daxil edin.</p>
                    </div>
                    <a asp-controller="User" asp-action="Create" class="btn btn-outline-success w-100 mt-3 rounded-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                        <!-- Pilyus (Plus) İkonu -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                        </svg>
                        Əlavə Et
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>